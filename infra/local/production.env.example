# 复制为项目根目录的 .env.stage14-production，仅在本机填写真实值并保持 0600。
APP_ENV=production
DATABASE_URL=<API 的 Supabase Session Pooler 连接>
EXPORT_DATABASE_URL=<paper_grading_export_worker 的 Session Pooler 连接>
REDIS_URL=redis://127.0.0.1:6379/0
SUPABASE_URL=<Supabase 项目 URL>
SUPABASE_PUBLISHABLE_KEY=<Supabase publishable key>
SUPABASE_SECRET_KEY=<Supabase secret key>
SUPABASE_STORAGE_BUCKET=<私有 bucket>
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=60
SUPABASE_STORAGE_TIMEOUT_SECONDS=60.0
PROVIDER_MASTER_KEY=<供应商主密钥>
PROVIDER_CALLS_ENABLED=false
AUTH_INVITE_REDIRECT_URL=https://<Sites 正式域名>/auth/callback
FRONTEND_ORIGIN=https://<Sites 正式域名>
VITE_API_BASE_URL=https://<Tailscale Funnel 域名>
VITE_SUPABASE_URL=<Supabase 项目 URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<Supabase publishable key>
UPTIMEROBOT_HEARTBEAT_URL=https://heartbeat.uptimerobot.com/<监控标识>

# 另建项目根目录 .env.stage14-grading-worker，只放下面一项：
# DATABASE_URL=<paper_grading_worker 的 Session Pooler 连接>
