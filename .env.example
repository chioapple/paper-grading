# 环境文件规则
# 1. 开发：可复制为 .env.development，并在启动前显式加载到当前 shell。
# 2. 测试：可复制为 .env.test，显式加载后使用独立测试数据库。
# 3. 生产：不创建或提交 .env.production；只在 Render 控制台注入。
# 空值表示必填配置。应用必须在启动时拒绝空值，不能提供默认密钥。

# 运行环境：development | test | production
APP_ENV=development

# 应用连接：生产环境使用 Supavisor session pooler 5432，并在 URL 中显式加 ?ssl=require。
# 本地可使用 PostgreSQL 直连；必须使用 postgresql+asyncpg，并指向当前环境自己的数据库。
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=5.0
READINESS_DATABASE_TIMEOUT_SECONDS=2.0
# 独立 Excel 导出 Worker 只能使用 0017 创建的 paper_grading_export_worker 角色。
# 生产同样使用 Supavisor session pooler 5432，但不得复用 DATABASE_URL 的 postgres 凭据。
EXPORT_DATABASE_URL=

# Celery broker；Redis 只传任务标识，不保存批次状态或论文内容。
REDIS_URL=redis://127.0.0.1:6379/0

# Supabase Auth 与 Storage：publishable key 可用于浏览器；secret key 只能注入后端，严禁使用 VITE_ 前缀。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5.0
# 私有 Storage 桶由用户在同一 Supabase 项目中创建；后端复用 secret key，不增加第二套凭据。
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=60
SUPABASE_STORAGE_TIMEOUT_SECONDS=60.0
# 供应商 API Key 的 AES-256-GCM 主密钥：本地生成 32 个随机字节后做标准 Base64。
# 只注入后端，严禁提交、发到聊天或使用 VITE_ 前缀。
PROVIDER_MASTER_KEY=
# 仅本地 VPN 增强模式验收可临时设为 true；只放行官方域名的 198.18.0.0/15，生产环境强制拒绝。
ALLOW_OFFICIAL_PROVIDER_FAKE_IP=false
# 必须加入 Supabase Auth 的 Redirect URLs，路径固定为 /auth/callback。
AUTH_INVITE_REDIRECT_URL=http://127.0.0.1:5173/auth/callback
# 后端 CORS 只允许这个单一来源。
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Vite 只读取以下三个公开配置。不得在任何 VITE_ 变量中放服务端密钥。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000

# 部署迁移连接：使用 ?ssl=require 的 Supabase direct 地址，禁止回退到 DATABASE_URL。
# Direct 地址需要执行环境支持 IPv6；不注入 Render API，只在受控迁移环境临时提供。
MIGRATION_DATABASE_URL=

# 真实 PostgreSQL 约束验收必须使用独立测试项目，禁止复用 MIGRATION_DATABASE_URL。
TEST_MIGRATION_DATABASE_URL=
# 权限、RLS 和事务验收使用同一测试项目的 Supavisor session pooler 5432。
# 不得填写 transaction pooler 6543，也不得指向其他 Supabase 项目。
TEST_DATABASE_URL=
# 必须与测试 URL 中 db.<project-ref>.supabase.co 的 project ref 完全一致。
TEST_SUPABASE_PROJECT_REF=
# 破坏性回放确认值固定如下；验收会删除并重建全部阶段 2 表。
TEST_DATABASE_RESET_CONFIRMATION=I_UNDERSTAND_THIS_DELETES_STAGE_2_DATA
# 两个用户必须通过 Dashboard 直接创建，已存在于测试项目 auth.users，且没有 profile；不要发送邀请。
TEST_TEACHER_AUTH_USER_ID=
TEST_OTHER_AUTH_USER_ID=
