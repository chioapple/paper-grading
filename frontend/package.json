{
  "name": "paper-grading-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/dependency-audit.node-test.mjs",
    "test:sites": "npm run build:sites && node --test scripts/sites-build.node-test.mjs",
    "test:watch": "vitest",
    "e2e:local": "playwright test --config playwright.config.ts",
    "e2e:real": "E2E_REAL=true playwright test --config playwright.real.config.ts",
    "audit:dependencies": "node scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
